# Retain real Host traces; bt_debug_init() sets runtime tags to INFO/WARN.
# ESP DEBUG is 4; Bluedroid's DEBUG trace selector is 5 (not Quec's numeric enum).
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y
CONFIG_BT_LOG_HCI_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_BTM_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_L2CAP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_SDP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_GAP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_A2D_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_AVDT_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_AVCT_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_AVRC_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_APPL_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_BTIF_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_BTC_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_OSI_TRACE_LEVEL_DEBUG=y
