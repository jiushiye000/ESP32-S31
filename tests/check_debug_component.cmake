cmake_minimum_required(VERSION 3.16)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CONFIG_EXAMPLE_BT_UI_ENABLE "${TEST_UI}")
set(CONFIG_GMF_EXAMPLE_AUDIO_TECH_LE OFF)
set(CONFIG_BT_BLUEDROID_ENABLED OFF)

# Inspect the real registrations, not a duplicate list of intended sources.
function(idf_component_register)
    cmake_parse_arguments(component "" "" "SRCS;INCLUDE_DIRS;REQUIRES;PRIV_REQUIRES" ${ARGN})
    if(component_name STREQUAL "main")
        foreach(source IN LISTS component_SRCS)
            if(source MATCHES "(^|/)bt_debug[^/]*\\.c$")
                message(FATAL_ERROR "Debug is still owned by main: ${source}")
            endif()
        endforeach()
        if(NOT "bt_debug" IN_LIST component_REQUIRES)
            message(FATAL_ERROR "Application must explicitly consume bt_debug")
        endif()
    else()
        foreach(source src/bt_debug.c src/bt_debug_policy.c src/bt_debug_storage.c src/bt_debug_console.c)
            if(NOT "${source}" IN_LIST component_SRCS)
                message(FATAL_ERROR "Missing Debug component implementation: ${source}")
            endif()
        endforeach()
        foreach(dependency IN LISTS component_REQUIRES component_PRIV_REQUIRES)
            if(dependency MATCHES "^(main|lvgl|esp_lvgl_port|esp_jpeg|bt_power|bt_ui|esp_bt_audio)$")
                message(FATAL_ERROR "Debug must not depend on application/UI/audio: ${dependency}")
            endif()
        endforeach()
        foreach(source IN LISTS component_SRCS)
            if(NOT EXISTS "${repo}/components/bt_debug/${source}")
                message(FATAL_ERROR "Missing selected Debug source: ${source}")
            endif()
        endforeach()
        if(NOT "include" IN_LIST component_INCLUDE_DIRS)
            message(FATAL_ERROR "Debug must publish its own headers")
        endif()
    endif()
endfunction()

set(component_name main)
include("${repo}/demo/a2dp_sink/main/CMakeLists.txt")
set(component_name bt_debug)
include("${repo}/components/bt_debug/CMakeLists.txt")
file(READ "${repo}/demo/a2dp_sink/main/cmd_reg.c" command_source)
if(command_source MATCHES "static int debug_config" OR command_source MATCHES "\\.command = \"debug\"")
    message(FATAL_ERROR "Debug CLI must be owned by the Debug component")
endif()
if(NOT command_source MATCHES "bt_debug_register_commands\\(\\)")
    message(FATAL_ERROR "Application must register Debug commands before starting the REPL")
endif()
message(STATUS "Debug component boundaries UI=${TEST_UI}: PASS")
